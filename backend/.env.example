# IssueFlow Backend Environment Configuration

PROJECT_NAME="IssueFlow"
VERSION="1.0.0"
API_V1_STR="/api"

# -----------------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# -----------------------------------------------------------------------------------------
# Step 1: Open Supabase Dashboard -> Project Settings -> Database
# Step 2: Under "Connection String", select "URI" -> "Session Pooler" (Port 5432)
# Step 3: Replace [YOUR-PASSWORD] with your actual Supabase database password
#
# Format:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres
DATABASE_URL=postgresql://postgres.ymsjcqvoftwfgfregvpm:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# CORS Allowed Origins (Frontend React development server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------------------
# Deployment & Environment Mode
# -----------------------------------------------------------------------------------------
ENVIRONMENT=development

# -----------------------------------------------------------------------------------------
# Initial Administrator Account Configuration
# (In production, replace with secure custom credentials before first launch)
# -----------------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@issueflow.com
INITIAL_ADMIN_PASSWORD=Admin@123
INITIAL_ADMIN_NAME="Sarah Jenkins"

# -----------------------------------------------------------------------------------------
# JWT Authentication & Security Configuration
# -----------------------------------------------------------------------------------------
SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------------------
# Google Gemini AI Configuration
# -----------------------------------------------------------------------------------------
# 1. Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# 2. Paste your Gemini API key below (Never commit your actual key to GitHub)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
