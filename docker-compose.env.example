# =============================================================================
# IssueFlow - Docker Compose Environment Configuration Example
# Copy this file to .env before running: docker compose up --build
# =============================================================================

# Deployment Environment ('development' or 'production')
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Database Connection String
# Replace [YOUR-PASSWORD] with your actual Supabase PostgreSQL password
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.ymsjcqvoftwfgfregvpm:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# JWT Authentication & Security
# Generate a strong 64-character secret using: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=issueflow-development-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# Initial Administrator Account
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@issueflow.com
INITIAL_ADMIN_PASSWORD=Admin@123
INITIAL_ADMIN_NAME="Sarah Jenkins"

# -----------------------------------------------------------------------------
# Google Gemini AI Integration
# Obtain a key from Google AI Studio: https://aistudio.google.com/
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# Network & CORS Allowed Origins
# In Docker Compose, the frontend runs on port 80 and backend on port 8000
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1
VITE_API_BASE_URL=http://localhost:8000

